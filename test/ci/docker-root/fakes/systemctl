#!/bin/bash
# fake systemctl (root tests): logs every call; enable --now / disable --now track "active" in a state file
L=/var/log/fake
mkdir -p "$L"
echo "systemctl $*" >>"$L/systemctl"
args=()
for a in "$@"; do [[ $a == --quiet || $a == --no-pager || $a == --user ]] || args+=("$a"); done
case ${args[0]:-} in
  is-active) if grep -qx "${args[1]}" "$L/active" 2>/dev/null; then echo active; exit 0; else echo inactive; exit 3; fi ;;
  is-enabled) grep -qx "${args[1]}" "$L/enabled" 2>/dev/null ;;
  enable) u=${args[-1]}; echo "$u" >>"$L/enabled"; [[ ${args[1]} == --now ]] && echo "$u" >>"$L/active"; exit 0 ;;
  disable) u=${args[-1]}; sed -i "\\#^${u}\$#d" "$L/enabled" "$L/active" 2>/dev/null; exit 0 ;;
  restart) echo "${args[1]}" >>"$L/active"; exit 0 ;;
  *) exit 0 ;;
esac
