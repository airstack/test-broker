# written by scripts/install.sh from install.conf; do not edit (re-run install)
[Unit]
Description=ci-brokerd
Wants=network-online.target
After=network-online.target docker.service

[Service]
User=@DAEMON_USER@
Group=@DAEMON_USER@
SupplementaryGroups=docker
Environment=HOME=@STATE_DIR@/admin
Environment=PATH=@TOOLS_DIR@:/usr/bin:/bin
ExecStart=@OPT_DIR@/current/bin/ci-brokerd
Restart=always
RestartSec=5
UMask=0027
ProtectSystem=strict
ReadWritePaths=-@STATE_DIR@/admin -@STATE_DIR@/local -@STATE_DIR@/sock -@OPT_DIR@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
